FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ksl;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
  xMin   { type cyclic; }  // 入口高压
  xMax   { type cyclic; }  // 出口参考压
  bottom { type zeroGradient; }
  top    { type zeroGradient; }
  yMin   { type cyclic; }
  yMax   { type cyclic; }
}
