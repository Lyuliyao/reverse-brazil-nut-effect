echo            both
log             ../DEM/log.liggghts

atom_style	    granular
atom_modify	    map array
communicate	    single vel yes

boundary        p p f     
newton		    off
units		    si

include         ../DEM/in.liggghts_variable
read_restart 	../DEM/post/restart/liggghts.restart

neighbor        5.0e-4 bin         
neigh_modify    every 1 delay 0 check yes 
communicate     single vel yes
newton          off   

include         ../DEM/in.liggghts_setting

fix		cfd all couple/cfd couple_every 100 mpi
fix		cfd2 all couple/cfd/force/implicit
#apply nve integration to all particles that are inserted as single particles
fix		integr all nve/sphere
#fix                 limit all nve/limit absolute 1e-4

compute         centerOfMass all com
compute         cc all contact/atom
#fix             avg_cc all ave/atom 100 2000 200000 c_cc
# sum of explicit and implicit drag force given from CFD to DEM
variable    dragtotalX equal f_cfd2[1]
variable    dragtotalY equal f_cfd2[2]
variable    dragtotalZ equal f_cfd2[3]

#screen output
compute		1 all erotate/sphere
thermo_style	custom step atoms ke c_1 vol c_centerOfMass[3] v_dragtotalX v_dragtotalY v_dragtotalZ
thermo		10000
thermo_modify	lost ignore norm no

#insert the first particles so that dump is not empty
#dump 		myDump all stl 1 post/dump_*.stl
#run		1
dump        dmp all custom 50000 ../DEM/post/forcebalance_segments/t39_to_40/dump*.liggghts_forcebalance id type mass x y z fx fy fz f_contactforce[1] f_contactforce[2] f_contactforce[3] f_wallforce[1] f_wallforce[2] f_wallforce[3] f_gradPForce[1] f_gradPForce[2] f_gradPForce[3] f_viscForce[1] f_viscForce[2] f_viscForce[3] f_fluidforce[1] f_fluidforce[2] f_fluidforce[3] f_dragforce[1] f_dragforce[2] f_dragforce[3] radius c_cc
#undump		myDump
#restart     200000 post/restart.*
run		    0 
