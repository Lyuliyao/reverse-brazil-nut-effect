+/* ---------------------------------------------------------------------- */
+
+void FixCfdCouplingForce::enable_wall_contactforce_storage()
+{
+  const int n_wall_fixes = modify->n_fixes_style("wall/gran");
+
+  for(int ifix = 0; ifix < n_wall_fixes; ifix++)
+  {
+    FixWallGran *wall_fix = static_cast<FixWallGran*>(modify->find_fix_style("wall/gran",ifix));
+    if(wall_fix)
+      wall_fix->enable_store_force_contact_every(1);
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixCfdCouplingForce::capture_contactforce_snapshot()
+{
+  int *mask = atom->mask;
+  int nlocal = atom->nlocal;
+  double **contactforce = fix_contactforce_->array_atom;
+
+  if(!pair_gran_ || !pair_gran_->fix_contact_forces())
+    error->fix_error(FLERR,this,"Pure particle-particle contactforce output requires a granular pair style defined before this fix");
+
+  FixContactPropertyAtom *contactforces = pair_gran_->fix_contact_forces();
+
+  for (int i = 0; i < nlocal; i++)
+  {
+    vectorZeroize3D(contactforce[i]);
+
+    if (!(mask[i] & groupbit))
+      continue;
+
+    const int npartners = contactforces->n_partner(i);
+    for (int ip = 0; ip < npartners; ip++)
+    {
+      double *contact = contactforces->contacthistory(i,ip);
+      contactforce[i][0] += contact[0];
+      contactforce[i][1] += contact[1];
+      contactforce[i][2] += contact[2];
+    }
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixCfdCouplingForce::capture_wallforce_snapshot()
+{
+  int *mask = atom->mask;
+  int nlocal = atom->nlocal;
+  double **wallforce = fix_wallforce_->array_atom;
+
+  for (int i = 0; i < nlocal; i++)
+    vectorZeroize3D(wallforce[i]);
+
+  const int n_wall_fixes = modify->n_fixes_style("wall/gran");
+  if(n_wall_fixes == 0)
+    return;
+
+  for(int ifix = 0; ifix < n_wall_fixes; ifix++)
+  {
+    FixWallGran *wall_fix = static_cast<FixWallGran*>(modify->find_fix_style("wall/gran",ifix));
+    if(!wall_fix)
+      continue;
+
+    if(wall_fix->is_mesh_wall())
+    {
+      FixMeshSurface **mesh_list = wall_fix->mesh_list();
+      const int n_meshes = wall_fix->n_meshes();
+
+      for(int imesh = 0; imesh < n_meshes; imesh++)
+      {
+        FixContactPropertyAtomWall *wallcontacts = mesh_list[imesh] ? mesh_list[imesh]->meshforceContact() : 0;
+        if(!wallcontacts)
+          error->fix_error(FLERR,this,"Wallforce output requires wall/gran contact storage to be available for each mesh wall");
+
+        for (int i = 0; i < nlocal; i++)
+        {
+          if (!(mask[i] & groupbit))
+            continue;
+
+          const int npartners = wallcontacts->n_partner(i);
+          for (int ip = 0; ip < npartners; ip++)
+          {
+            double *contact = wallcontacts->contacthistory(i,ip);
+            wallforce[i][0] += contact[0];
+            wallforce[i][1] += contact[1];
+            wallforce[i][2] += contact[2];
+          }
+        }
+      }
+
+      continue;
+    }
+
+    FixContactPropertyAtomWall *wallcontacts = wall_fix->contactforce_fix();
+    if(!wallcontacts)
+      error->fix_error(FLERR,this,"Wallforce output requires wall/gran contact storage to be available for each primitive wall");
+
+    for (int i = 0; i < nlocal; i++)
+    {
+      if (!(mask[i] & groupbit))
+        continue;
+
+      const int npartners = wallcontacts->n_partner(i);
+      for (int ip = 0; ip < npartners; ip++)
+      {
+        double *contact = wallcontacts->contacthistory(i,ip);
+        wallforce[i][0] += contact[0];
+        wallforce[i][1] += contact[1];
+        wallforce[i][2] += contact[2];
+      }
+    }
+  }
+}
+
