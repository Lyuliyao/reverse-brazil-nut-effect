+#==================================#
+#- helper to run MPI commands
+
+runMPICommand()
+{
+    nrProcs="$1"
+    machineFileName="$2"
+    debugMode="$3"
+    shift 3
+
+    if [[ "${SLURM_JOB_ID:-}" != "" && "${CFDEM_USE_SRUN:-true}" != "false" ]]; then
+        if [[ $machineFileName != "none" && $machineFileName != "" ]]; then
+            echo "WARNING: machinefile '$machineFileName' ignored because CFDEM is using srun inside Slurm."
+        fi
+        SRUN_MPI_TYPE="${CFDEM_SRUN_MPI_TYPE:-pmix}"
+        srun --mpi="$SRUN_MPI_TYPE" --overlap -n "$nrProcs" $debugMode "$@"
+    else
+        MPIRUN_CMD=`get_mpirun_cmd`
+        if [[ $machineFileName == "none" ]]; then
+            $MPIRUN_CMD -np "$nrProcs" $debugMode "$@"
+        else
+            $MPIRUN_CMD -machinefile "$machineFileName" -np "$nrProcs" $debugMode "$@"
+        fi
+    fi
+}
